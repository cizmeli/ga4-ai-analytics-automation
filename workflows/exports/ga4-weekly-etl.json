{
  "id": "6346245e-1f12-4d69-a056-27d3b44bf50d",
  "name": "GA4 Weekly ETL",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH latest_week AS (\n    SELECT\n        COALESCE(\n            MAX(week_end),\n            DATE '2020-10-31'\n        ) AS last_date\n    FROM public.weekly_kpis\n)\nSELECT\n    TO_CHAR(\n        last_date + 1,\n        'YYYY-MM-DD'\n    ) AS week_start,\n\n    TO_CHAR(\n        LEAST(\n            last_date + 7,\n            DATE '2021-01-31'\n        ),\n        'YYYY-MM-DD'\n    ) AS week_end\n\nFROM latest_week\nWHERE last_date < DATE '2021-01-31';\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -112,
        -32
      ],
      "id": "afbb4d73-734a-444a-854a-764a468f774a",
      "name": "Supabase-Get Next Week"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -336,
        -32
      ],
      "id": "8f63751f-aa21-4b21-8421-a52111c3a621",
      "name": "Schedule Trigger",
      "disabled": true
    },
    {
      "parameters": {
        "projectId": {
          "__rl": true,
          "value": "REPLACE_WITH_GCP_PROJECT_ID",
          "mode": "list"
        },
        "sqlQuery": "\nSELECT\n  DATE '{{ $json.week_start }}' AS week_start,\n  DATE '{{ $json.week_end }}' AS week_end,\n\n  COUNT(*) AS total_events,\n\n  COUNT(DISTINCT user_pseudo_id) AS total_users,\n\n  COUNTIF(event_name = 'purchase') AS purchases,\n\n  COUNT(DISTINCT IF(\n    event_name = 'purchase',\n    user_pseudo_id,\n    NULL\n  )) AS purchase_users,\n\n  ROUND(\n    SUM(\n      IF(\n        event_name = 'purchase',\n        COALESCE(ecommerce.purchase_revenue_in_usd, 0),\n        0\n      )\n    ),\n    2\n  ) AS revenue_usd\n\nFROM\n  `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`\n\nWHERE\n  _TABLE_SUFFIX BETWEEN\n    REPLACE('{{ $json.week_start }}', '-', '')\n    AND\n    REPLACE('{{ $json.week_end }}', '-', '');\n",
        "options": {}
      },
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        112,
        -32
      ],
      "id": "c758c8ec-40ba-4fba-8aba-39bac8a83cba",
      "name": "BigQuery-Weekly KPIs"
    },
