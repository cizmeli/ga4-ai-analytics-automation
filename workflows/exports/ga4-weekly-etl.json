{
  "name": "GA4 Weekly ETL",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH latest_week AS (\n    SELECT\n        COALESCE(\n            MAX(week_end),\n            DATE '2020-10-31'\n        ) AS last_date\n    FROM public.weekly_kpis\n)\nSELECT\n    TO_CHAR(\n        last_date + 1,\n        'YYYY-MM-DD'\n    ) AS week_start,\n\n    TO_CHAR(\n        LEAST(\n            last_date + 7,\n            DATE '2021-01-31'\n        ),\n        'YYYY-MM-DD'\n    ) AS week_end\n\nFROM latest_week\nWHERE last_date < DATE '2021-01-31';\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -112,
        256
      ],
      "id": "606f6cb2-ea8b-4b20-b36e-bbe21ab16457",
      "name": "Supabase-Get Next Week"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -336,
        352
      ],
      "id": "56121beb-ed52-4653-b362-3eb822ebd36d",
