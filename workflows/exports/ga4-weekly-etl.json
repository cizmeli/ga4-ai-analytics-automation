    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH latest_week AS (\n    SELECT\n        COALESCE(\n            MAX(week_end),\n            DATE '2020-10-31'\n        ) AS last_date\n    FROM public.weekly_kpis\n)\nSELECT\n    TO_CHAR(\n        last_date + 1,\n        'YYYY-MM-DD'\n    ) AS week_start,\n\n    TO_CHAR(\n        LEAST(\n            last_date + 7,\n            DATE '2021-01-31'\n        ),\n        'YYYY-MM-DD'\n    ) AS week_end\n\nFROM latest_week\nWHERE last_date < DATE '2021-01-31';\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
